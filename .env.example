# Local learning setup. Keep your real .env out of Git.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_ENGINE=sqlite
POSTGRES_DB=incidentlens
POSTGRES_USER=incidentlens
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
INCIDENTLENS_API_URL=http://127.0.0.1:8000/api
# This is an operator-controlled allowlist, not a user setting.
MONITOR_ALLOWED_HOSTS=localhost,127.0.0.1,demo
DEMO_CONTROL_KEY=replace-with-a-local-demo-control-key
